# =============================================================================
# AutoMeetRecorder 環境設定
# =============================================================================
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# -----------------------------------------------------------------------------
# 資料庫設定 (必要)
# -----------------------------------------------------------------------------

# 資料庫連線字串
DATABASE_URL=sqlite:///./data/app.db

# Docker runtime identity
# 預設僅綁定 loopback APP_PORT=8000；VNC 預設關閉。
# dev wrapper 使用 APP_PORT=8001；debug override 才使用 VNC_PORT=5901。
# APP_BIND_ADDRESS=127.0.0.1
# APP_UID=1000
# APP_GID=1000
# MEETING_RECORDER_REVISION=<git commit SHA>
# APP_PORT=8000
# VNC_PORT=5900
# COMPOSE_PROJECT_NAME=meeting-recorder-prod
# MEETING_RECORDER_CONTAINER_NAME=meeting-recorder
# MEETING_RECORDER_IMAGE=ghcr.io/eyeduck-ai/meeting_recorder:latest

# -----------------------------------------------------------------------------
# 認證設定 (選填)
# -----------------------------------------------------------------------------
# 若不設定則 Web UI 與 API 無需登入

# AUTH_PASSWORD=your-password-here
# AUTH_SESSION_SECRET=change-me-in-production

# CORS 只在需要跨來源 browser client 呼叫 API 時設定。
# 使用逗號分隔明確允許的 origins；預設留空代表不啟用 CORS；不支援 wildcard `*`。
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://ops.example.com

# -----------------------------------------------------------------------------
# Telegram Bot (選填)
# -----------------------------------------------------------------------------
# 向 @BotFather 建立 Bot 取得 Token
# 不需要 TELEGRAM_CHAT_ID；對 Bot 發送 /start 後，到 Web UI /settings 核准。
# 使用 polling，無需 Telegram webhook 或公開網址。

# TELEGRAM_BOT_TOKEN=your_bot_token_here

# -----------------------------------------------------------------------------
# YouTube API (選填)
# -----------------------------------------------------------------------------
# 1. 前往 https://console.cloud.google.com/
# 2. 建立專案並啟用 YouTube Data API v3
# 3. 設定 OAuth consent screen；External / Testing 時加入實際上傳帳號為 Test user
# 4. 建立 OAuth 2.0 憑證 (TVs and Limited Input devices 類型，非 Desktop App)
# 5. 從下載的 OAuth client JSON 取出 client_id / client_secret
# 6. 在 Web UI /settings 頁面完成授權，程式會建立 data/youtube_token.json
# Device Flow 使用 youtube scope（管理 YouTube），不支援 youtube.upload scope。
# External / Testing 的 refresh token 通常 7 天失效，長期使用需確認發布狀態。

# YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_DEFAULT_PRIVACY=unlisted

# -----------------------------------------------------------------------------
# 除錯設定 (選填)
# -----------------------------------------------------------------------------

# 額外載入 docker-compose.debug.yml 才啟用 VNC（127.0.0.1:5900，無密碼）。
# VNC 會等待指定 active job display，不另外占用 display。
# DEBUG_VNC_DISPLAY=100

# FFmpeg 除錯與容錯 (選填)
# FFMPEG_DEBUG_TS=1
# FFMPEG_STALL_TIMEOUT_SEC=120
# FFMPEG_STALL_GRACE_SEC=30
# FFMPEG_STOP_GRACE_SEC=5
# FFMPEG_SIGINT_TIMEOUT_SEC=8
# FFMPEG_SIGTERM_TIMEOUT_SEC=5

# Recording defaults before DB/UI overrides (選填)
# Conservative smart trim padding; DB/UI values take precedence.
# SMART_TRIM_PRE_ROLL_SEC=15
# SMART_TRIM_END_POST_ROLL_SEC=30
# MAX_CONCURRENT_RECORDINGS must be <= RECORDING_DISPLAY_POOL_SIZE
# MAX_CONCURRENT_RECORDINGS=2
# RECORDING_DISPLAY_START=100
# RECORDING_DISPLAY_POOL_SIZE=16
# MIN_FREE_DISK_GB_BEFORE_RECORDING=10
# RECORDING_BROWSER_MODE=app
# RECORDING_CROP_MODE=off
# RECORDING_CROP_TOP_PX=0

# FFmpeg 上傳前轉檔壓縮 (選填)
# FFMPEG_TRANSCODE_ON_UPLOAD=1
# FFMPEG_TRANSCODE_PRESET=slow
# FFMPEG_TRANSCODE_CRF=28
# FFMPEG_TRANSCODE_AUDIO_BITRATE=96k
# MAX_PARALLEL_TRANSCODES=1

# =============================================================================
# 以下設定已移至資料庫，可透過 Web UI /settings 頁面調整：
# - 解析度 (resolution_w, resolution_h)
# - 瀏覽器模式與上方裁切 fallback (recording_browser_mode, recording_crop_mode, recording_crop_top_px)
# - FFmpeg 預設 (ffmpeg_preset)
# - Lobby 等待時間 (lobby_wait_sec)
# - Jitsi Base URL (jitsi_base_url)
# - 提前登入秒數 (pre_join_seconds)
# - 時區 (tz)
# =============================================================================
